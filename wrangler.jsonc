// Cloudflare Worker con archivos estáticos: sube dist/ y sirve index.html en cualquier ruta (SPA).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bethel-institute",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
