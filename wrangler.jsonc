// Cloudflare Workers con archivos estáticos: el build de Cloudflare corre `npm run build` y después
// `npx wrangler deploy`, que sube la carpeta dist. No lleva script ("main"): solo sirve la app.
// not_found_handling = single-page-application: cualquier ruta (/app/alumnos…) devuelve index.html.
// public/_headers (copiado a dist) pone la caché: /assets/* para siempre, index.html nunca.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bethel-institute",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
